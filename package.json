{
  "name": "dock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-logo-assets.mjs && convex dev --start \"next dev --turbopack -p 3001\"",
    "dev:frontend": "node scripts/ensure-logo-assets.mjs && next dev --turbopack -p 3001",
    "build": "next build",
    "start": "next start",
    "test:page-access": "node --test convex/lib/pageAccessCore.test.ts",
    "test:custom-domains": "node --test convex/lib/customDomainValidators.test.ts convex/lib/customDomainsConfig.test.ts",
    "generate:logo-raster": "npx sharp-cli -i public/dock-logo.svg -o public/dock-logo-raster.png resize 1024 1024",
    "generate:logo-gem-smoke": "node scripts/generate-gem-smoke-logo.mjs",
    "postinstall": "node scripts/ensure-logo-assets.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@aws-sdk/client-s3": "^3.1132.0",
    "@convex-dev/auth": "^0.0.95",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "@paper-design/shaders": "^0.0.80",
    "@paper-design/shaders-react": "^0.0.80",
    "@smithy/node-http-handler": "^4.12.1",
    "boxicons": "^2.1.4",
    "convex": "^1.44.0",
    "gsap": "^3.15.0",
    "nanoid": "^6.0.1",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
